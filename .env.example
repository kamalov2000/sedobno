# Скопируй в .env (`make env`) и заполни секреты. .env в git не коммитится.
# Значения-плейсхолдеры позволяют `make up` подняться локально; перед деплоем — заменить.

# --- HTTP ---
PORT=8080
LOG_LEVEL=info

# --- Postgres (используется и compose-сервисом, и приложением) ---
POSTGRES_USER=sostav
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sostav
DATABASE_URL=postgres://sostav:change-me-postgres@postgres:5432/sostav?sslmode=disable

# --- Секреты приложения (ОБЯЗАТЕЛЬНО заменить перед деплоем) ---
JWT_SECRET=change-me-jwt-secret
ADMIN_KEY=change-me-admin-key
TELEGRAM_BOT_TOKEN=000000:CHANGE_ME
# База Telegram Bot API. Менять не нужно; в тестах/локальном смоуке можно указать стаб.
TELEGRAM_API_BASE=https://api.telegram.org
# Секрет вебхука: то же значение задаётся при setWebhook (secret_token). Обязателен.
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# chat_id, куда бот форвардит обратную связь (личный chat_id владельца). Обязателен.
FEEDBACK_CHAT_ID=0
# https-URL mini-app для кнопки в /start. ОБЯЗАТЕЛЕН НА ПРОДЕ (иначе /start без кнопки открытия).
WEBAPP_URL=

# --- LLM-провайдер: anthropic | groq | openai | mock (mock — прогон пайплайна без ключей/стоимости) ---
# Дефолт — anthropic (claude-haiku-4-5): по сравнению на 15 реальных фото лучший баланс
# цена/латентность/качество (Haiku 0.71₽/4.9с; Sonnet 2.23₽/8с взят как extract-fallback;
# Groq на free-tier ловил 429 на 8/15 — оставлен как альтернатива, не дефолт). См. SPEC §4.
LLM_PROVIDER=anthropic
# Обязателен ключ ТОЛЬКО выбранного провайдера (fail-fast §11): anthropic→ANTHROPIC_API_KEY,
# groq→GROQ_API_KEY, openai→OPENAI_API_KEY, mock→ничего. Остальные можно оставить пустыми.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-change-me

# Модели и базы (опционально — есть разумные значения по умолчанию)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TEXT_MODEL=gpt-4o-mini
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_VISION_MODEL=claude-haiku-4-5
# ANTHROPIC_TEXT_MODEL=claude-haiku-4-5
# Extract-fallback фазы 1 (решение сравнения): при неуверенном чтении (is_label:false
# или confidence < EXTRACT_CONFIDENCE_MIN) — один повторный вызов извлечения более сильной моделью.
# Дефолт в коде — claude-sonnet-5, АКТИВЕН автоматически при LLM_PROVIDER=anthropic (не-anthropic → выкл).
# Чтобы выключить — задай пустым: EXTRACT_FALLBACK_MODEL=. Строки ниже — переопределение дефолтов.
# EXTRACT_FALLBACK_MODEL=claude-sonnet-5
# EXTRACT_CONFIDENCE_MIN=0.5

# Пайплайн (§4, §15): семафор на LLM, таймаут одного вызова, курс для оценки ₽/скан
LLM_MAX_CONCURRENT=20
LLM_TIMEOUT_SEC=12
LLM_USD_RUB=95

# --- Подписка Telegram Stars (§9) ---
SUBSCRIPTION_STARS_PRICE=150

# --- СБП/карта через ЮKassa (§14.1). Опциональный канал оплаты. ---
# Выключен по умолчанию. При SBP_ENABLED=true обязательны ключи ЮKassa и лендинг (fail-fast §11).
SBP_ENABLED=false
SBP_PRICE_RUB=249
# Ключи из ЛК ЮKassa (только на api, не на лендинге). Пусты при выключенном канале.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Лендинг, куда ведёт подписанная ссылка с пейволла (user_id + HMAC), и секрет подписи.
LANDING_URL=
LANDING_LINK_SECRET=
# База API ЮKassa (менять не нужно; в тестах — стаб).
# YOOKASSA_API_BASE=https://api.yookassa.ru/v3
# Доверенные сети вебхука ЮKassa (IP-allowlist, §14.1). По умолчанию — официальные диапазоны;
# переопределять только если ЮKassa сменит их в доке. Список CIDR через запятую.
# YOOKASSA_ALLOWLIST=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11/32,77.75.156.35/32,77.75.154.128/25,2a02:5180::/32

# --- Домен для Caddy: локально ":80", в проде — например example.com (даст авто-TLS) ---
SITE_ADDRESS=:80
