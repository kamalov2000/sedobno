# Бета-инстанс (feature/calories). Скопируй в deploy/.env.beta и заполни секреты.
# deploy/.env.beta в git НЕ коммитится (см. .gitignore). Прод .env не трогаем — у беты
# всё своё: БД sedobno_beta, бот @sedobno_beta_bot, поддомен.

PORT=8080
LOG_LEVEL=info

# --- Отдельная БД беты (контейнер postgres-beta, том pgdata_beta) ---
POSTGRES_USER=sostav
POSTGRES_PASSWORD=change-me-beta-pg
POSTGRES_DB=sedobno_beta
DATABASE_URL=postgres://sostav:change-me-beta-pg@postgres-beta:5432/sedobno_beta?sslmode=disable

# --- Секреты беты (свои, НЕ прод) ---
JWT_SECRET=change-me-beta-jwt
ADMIN_KEY=change-me-beta-admin
# Токен ТЕСТОВОГО бота @sedobno_beta_bot (из BotFather).
TELEGRAM_BOT_TOKEN=000000:CHANGE_ME_BETA_BOT
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=change-me-beta-webhook
FEEDBACK_CHAT_ID=0
# URL mini-app беты (поддомен + /app). Подставь свой поддомен.
WEBAPP_URL=https://beta.sedobno-pay.ru/app

# --- Окружение беты ---
# APP_ENV=beta (не dev) → dev-обход авторизации ВЫКЛЮЧЕН на публичном URL.
APP_ENV=beta
DEV_AUTH_BYPASS=false
# Расширенная диагностика разборов еды → калибровочный датасет в events (только бета).
MEAL_DIAG_VERBOSE=true

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-change-me
# Для замера качества можно поднять vision-модель калорий (по умолчанию Haiku):
# MEAL_VISION_MODEL=claude-sonnet-5

# Порог форс-эскалации сканера составов по плотности мелкого текста на кадре
# (pipeline/hallucination.go). На таких кадрах дешёвая модель не читает состав, а
# сочиняет его — согласованно с собственной transcription, поэтому гейт молчит.
# Значение на шкале imaging.Measure ИМЕННО этой реализации; калибруется по полю
# fine_loss в событиях scan_ok. 0 — выключить (аварийный откат без пересборки).
# По умолчанию 0.40 — накрывает оба известных случая (онигири 0.69, чай 0.44).
# SCAN_FORCE_ESCALATE_FINE_LOSS=0.40

LLM_MAX_CONCURRENT=20
LLM_TIMEOUT_SEC=25
LLM_USD_RUB=95

# --- Подписка (для теста; списание — Stars) ---
SUBSCRIPTION_STARS_PRICE=150

# --- СБП выключен на бете ---
SBP_ENABLED=false
