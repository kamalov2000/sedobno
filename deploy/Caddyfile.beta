# Бета-поддомен модуля калорий (feature/calories). ДОПОЛНЕНИЕ к живому Caddyfile —
# не редактируйте прод-блок, просто добавьте этот сайт (см. README раздел «Бета»).
# Caddy сам возьмёт TLS через ACME (нужна DNS A-запись beta.<домен> → IP VPS и открытые
# 80/443). api-beta/web-beta — контейнеры beta-проекта в той же docker-сети.
#
# Замените beta.sedobno-pay.ru на ваш поддомен, если домен другой.
beta.sedobno-pay.ru {
	encode gzip

	# API беты — на отдельный Go-контейнер (своя БД sedobno_beta).
	handle /api/* {
		reverse_proxy api-beta:8080
	}

	# Mini-app беты (Telegram WebApp) на /app и ассеты на /assets.
	@miniapp path /app /app/* /assets/*
	handle @miniapp {
		reverse_proxy web-beta:80
	}

	# Корень поддомена → mini-app (лендинга на бете нет).
	handle {
		redir /app 302
	}
}
